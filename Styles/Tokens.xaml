<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font Family -->
    <FontFamily x:Key="AppFont">Inter, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>

    <!-- Elevation Palette -->
    <Color x:Key="ChassisColor">#0A0A0A</Color>
    <Color x:Key="WindowColor">#0D0D0D</Color>
    <Color x:Key="SidebarColor">#0E0E0E</Color>
    <Color x:Key="SurfaceColor">#141414</Color>
    <Color x:Key="CardColor">#121214</Color>
    <Color x:Key="CardHoverColor">#18181B</Color>
    <Color x:Key="InputColor">#141416</Color>
    <Color x:Key="InputFocusColor">#18181C</Color>
    <Color x:Key="BottomPanelColor">#0D0D0F</Color>

    <!-- Borders -->
    <Color x:Key="BorderHairlineColor">#1C1C1F</Color>
    <Color x:Key="BorderCardColor">#1F1F23</Color>
    <Color x:Key="BorderCardHoverColor">#2A2A30</Color>
    <Color x:Key="BorderSubtleColor">#222226</Color>

    <!-- Typography -->
    <Color x:Key="TextPrimaryColor">#F4F4F5</Color>
    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
    <Color x:Key="TextMutedColor">#71717A</Color>
    <Color x:Key="TextDimColor">#52525B</Color>
    <Color x:Key="TextInverseColor">#09090B</Color>

    <!-- Accents -->
    <Color x:Key="AccentGreenColor">#60A5FA</Color>
    <Color x:Key="AccentGreenGlowColor">#4060A5FA</Color>
    <Color x:Key="AccentPastelBlueColor">#60A5FA</Color>
    <Color x:Key="AccentPastelBlueGlowColor">#4060A5FA</Color>
    <Color x:Key="AccentCTAColor">#E4E4E7</Color>
    <Color x:Key="AccentCTAHoverColor">#F4F4F5</Color>
    <Color x:Key="AccentRedColor">#EF4444</Color>
    <Color x:Key="AccentBlueColor">#60A5FA</Color>
    <Color x:Key="AccentPurpleColor">#A855F7</Color>
    <Color x:Key="AccentYellowColor">#EAB308</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="ChassisBrush" Color="{StaticResource ChassisColor}"/>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}"/>
    <SolidColorBrush x:Key="InputFocusBrush" Color="{StaticResource InputFocusColor}"/>
    <SolidColorBrush x:Key="BottomPanelBrush" Color="{StaticResource BottomPanelColor}"/>

    <SolidColorBrush x:Key="BorderHairlineBrush" Color="{StaticResource BorderHairlineColor}"/>
    <SolidColorBrush x:Key="BorderCardBrush" Color="{StaticResource BorderCardColor}"/>
    <SolidColorBrush x:Key="BorderCardHoverBrush" Color="{StaticResource BorderCardHoverColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverseColor}"/>

    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentGreenGlowBrush" Color="{StaticResource AccentGreenGlowColor}"/>
    <SolidColorBrush x:Key="AccentCTABrush" Color="{StaticResource AccentCTAColor}"/>
    <SolidColorBrush x:Key="AccentCTAHoverBrush" Color="{StaticResource AccentCTAHoverColor}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellowColor}"/>

    <!-- Radii and Dimensions -->
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusInput">6</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">4</CornerRadius>
    <CornerRadius x:Key="RadiusPill">9999</CornerRadius>

</ResourceDictionary>
