<UserControl x:Class="Crunch.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             FontFamily="{StaticResource AppFont}"
             d:DesignHeight="750" d:DesignWidth="920">
    <Grid Margin="36,28,36,28">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Category Selector Pills & Actions Bar -->
            <RowDefinition Height="Auto"/>
            <!-- File List View -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="Large File &amp; Dormant Hunter" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Find massive files and dormant gigabytes that haven't been touched in over 6 months." 
                           FontSize="13" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cancel Scan" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Command="{Binding CancelScanCommand}"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                        Margin="0,0,12,0"/>
                <Button Content="Start Full Scan" 
                        Style="{StaticResource EmeraldCtaButtonStyle}" 
                        Command="{Binding StartLargeFileScanCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Category Selector Pills & Actions Bar -->
        <Border Grid.Row="1" 
                Background="{StaticResource CardBrush}" 
                BorderBrush="{StaticResource BorderCardBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="14,10" 
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <RadioButton Content="Sleeping Giants" 
                                 GroupName="FilterTabs" 
                                 Style="{StaticResource PillRadioTabStyle}"
                                 IsChecked="True" 
                                 Checked="OnSleepingGiantsSelected"/>

                    <RadioButton Content="Installers &amp; ISOs" 
                                 GroupName="FilterTabs" 
                                 Style="{StaticResource PillRadioTabStyle}"
                                 Checked="OnInstallersSelected"/>

                    <RadioButton Content="Massive Media" 
                                 GroupName="FilterTabs" 
                                 Style="{StaticResource PillRadioTabStyle}"
                                 Checked="OnMediaSelected"/>

                    <RadioButton Content="Cold Archives" 
                                 GroupName="FilterTabs" 
                                 Style="{StaticResource PillRadioTabStyle}"
                                 Checked="OnArchivesSelected"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Select / Deselect All" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Height="28" 
                            Padding="12,0"
                            FontSize="11"
                            Command="{Binding ToggleSelectAllActiveFilesCommand}"
                            Margin="0,0,10,0"/>

                    <Border Background="#101F33" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="4" Padding="10,5">
                        <TextBlock Text="{Binding FormattedActiveCategorySize, StringFormat='Identified: {0}'}" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource AccentGreenBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- File List View -->
        <Border Grid.Row="2" 
                Background="{StaticResource CardBrush}" 
                BorderBrush="{StaticResource BorderCardBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="0"
                ClipToBounds="True">
            <Grid>
                <!-- Empty State (Shown when list is empty) -->
                <Grid x:Name="EmptyStateGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveScannerFilesCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center" Margin="32">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="{StaticResource MoonIconData}" Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="1.5" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ready to scan for dormant files" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click 'Start Full Scan' to discover multi-gigabyte files untouched in over 6 months." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,20"/>
                        <Button Content="Start Full Scan" 
                                Style="{StaticResource EmeraldCtaButtonStyle}" 
                                Height="34" Padding="20,0" 
                                HorizontalAlignment="Center"
                                Command="{Binding StartLargeFileScanCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Active File List -->
                <ListView x:Name="FileListView" 
                          ItemsSource="{Binding ActiveScannerFiles}" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto" 
                          ScrollViewer.CanContentScroll="True" 
                          VirtualizingStackPanel.IsVirtualizing="True" 
                          VirtualizingStackPanel.VirtualizationMode="Recycling" 
                          VirtualizingStackPanel.ScrollUnit="Pixel" 
                          Padding="0,0,6,0" 
                          Foreground="{StaticResource TextPrimaryBrush}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Padding" Value="16,12,12,12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="230"/>
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- Left: File Name & Path -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FullPath}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Size Pill -->
                                <Border Grid.Column="2" 
                                        Background="#101F33" 
                                        BorderBrush="#1E3A5F" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="8,3" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Center"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="{Binding FormattedSize}" 
                                               FontSize="12" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>

                                <!-- Age / Last Modified -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding AgeInDays, StringFormat='{}{0} days old'}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FormattedLastModified}" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Actions (Fixed 230px, Never Clipped by scrollbar) -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="Reveal" 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Height="28" 
                                            Padding="10,0"
                                            Command="{Binding DataContext.RevealFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding FullPath}"
                                            Margin="0,0,6,0"/>

                                    <Button Content="Force Unlock" 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Height="28" 
                                            Padding="10,0"
                                            Command="{Binding DataContext.ForceUnlockAndKillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding .}"
                                            Margin="0,0,6,0"/>

                                    <Button Content="Shred" 
                                            Style="{StaticResource DangerButtonStyle}" 
                                            Height="28" 
                                            Padding="12,0"
                                            Command="{Binding DataContext.DeleteSingleFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding .}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
