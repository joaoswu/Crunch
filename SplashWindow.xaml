<Window x:Class="Crunch.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crunch Starting" 
        Icon="pack://application:,,,/Assets/app.ico"
        Height="320" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Clean Single Rounded Chassis Card -->
    <Border Background="{StaticResource WindowBrush}" 
            BorderBrush="{StaticResource BorderCardBrush}" 
            BorderThickness="1" 
            CornerRadius="14">
        <Grid Margin="32,20,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 5-Segment Official Logo (Clockwise Petal Assembly with High-Quality Bicubic Scaling) -->
            <Grid Grid.Row="0" Width="130" Height="130" HorizontalAlignment="Center" Margin="0,16,0,12">
                <!-- Segment 1: Top Right -->
                <Image x:Name="Seg1" 
                       Source="Assets/segment_1.png" 
                       Width="130" Height="130" 
                       RenderTransformOrigin="0.5,0.5" 
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Opacity="0">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="Scale1" ScaleX="0.6" ScaleY="0.6"/>
                    </Image.RenderTransform>
                </Image>

                <!-- Segment 2: Top Left -->
                <Image x:Name="Seg2" 
                       Source="Assets/segment_2.png" 
                       Width="130" Height="130" 
                       RenderTransformOrigin="0.5,0.5" 
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Opacity="0">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="Scale2" ScaleX="0.6" ScaleY="0.6"/>
                    </Image.RenderTransform>
                </Image>

                <!-- Segment 3: Mid Left -->
                <Image x:Name="Seg3" 
                       Source="Assets/segment_3.png" 
                       Width="130" Height="130" 
                       RenderTransformOrigin="0.5,0.5" 
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Opacity="0">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="Scale3" ScaleX="0.6" ScaleY="0.6"/>
                    </Image.RenderTransform>
                </Image>

                <!-- Segment 4: Bottom Left -->
                <Image x:Name="Seg4" 
                       Source="Assets/segment_4.png" 
                       Width="130" Height="130" 
                       RenderTransformOrigin="0.5,0.5" 
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Opacity="0">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="Scale4" ScaleX="0.6" ScaleY="0.6"/>
                    </Image.RenderTransform>
                </Image>

                <!-- Segment 5: Bottom Right -->
                <Image x:Name="Seg5" 
                       Source="Assets/segment_5.png" 
                       Width="130" Height="130" 
                       RenderTransformOrigin="0.5,0.5" 
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Opacity="0">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="Scale5" ScaleX="0.6" ScaleY="0.6"/>
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <!-- Tagline with quotation marks, pushed up closer to the logo -->
            <TextBlock Grid.Row="1" 
                       Text="&quot;Crunch your storage.&quot;" 
                       FontSize="13" 
                       FontWeight="Medium"
                       Foreground="{StaticResource TextSecondaryBrush}" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Smooth Minimalist Loading Bar (No text, just sleek smooth progress) -->
            <ProgressBar Grid.Row="3" 
                         x:Name="SplashProgressBar" 
                         Height="3" 
                         Margin="36,0,36,2" 
                         Maximum="100" 
                         Value="5"/>

            <!-- Subtle Version Identifier -->
            <TextBlock Grid.Row="4" 
                       Text="v1.0.0" 
                       FontSize="10" 
                       FontWeight="Normal"
                       Foreground="{StaticResource TextDimBrush}" 
                       HorizontalAlignment="Right"
                       Margin="0,0,36,8"/>
        </Grid>
    </Border>
</Window>